\begin{tikzpicture}[scale=0.7,transform shape]
% Vertices
    \node (O) at (0,0) {\(O\)};
    \node (A) [above left = of O] {\(A\)};
    \node (B) [above right = of O] {\(B\)};
    \node (C) [above right = of A] {\(C\)};
% Edges
    \path[->] (O) edge[loop below] (O);
    \path[] (A) edge[loop left] (A);
    \path (B) edge[loop right] (B);
    \path[->] (C) edge[loop above] (C);
\end{tikzpicture}